# Server-only Supabase credentials. Never expose the service-role key as a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional in local development.
APP_URL=http://localhost:8080
PORT=8787

# Server-only Momence lead webhook configuration.
MOMENCE_MUMBAI_HOST_ID=
MOMENCE_MUMBAI_TOKEN=
MOMENCE_MUMBAI_SOURCE_ID=
MOMENCE_BENGALURU_HOST_ID=
MOMENCE_BENGALURU_TOKEN=
MOMENCE_BENGALURU_SOURCE_ID=
