# Server-only Supabase credentials. Never expose the service-role key as a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional in local development.
APP_URL=http://localhost:8080
PORT=8787

# Server-only Momence lead webhook configuration.
# Each Momence host has its own webhook token. Lead source IDs live in server/index.mjs.
MOMENCE_MUMBAI_HOST_ID=
MOMENCE_LEAD_WEBHOOK_TOKEN_MUMBAI=
MOMENCE_BENGALURU_HOST_ID=
MOMENCE_LEAD_WEBHOOK_TOKEN_BENGALURU=

# Momence public API credentials (Mumbai/default and Bengaluru account).
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
MOMENCE_CLIENT_ID_BLR=
MOMENCE_CLIENT_SECRET_BLR=
MOMENCE_USERNAME_BLR=
MOMENCE_PASSWORD_BLR=

# Dashboard login is required for child accounts, waiver signatures and auto-booking.
MOMENCE_LOGIN_EMAIL=
MOMENCE_LOGIN_PASSWORD=
MOMENCE_TOTP_SECRET=

# Stripe Checkout is used by paid signup forms. Keep these server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sheets: every new form gets a public (view-only) sheet named after the event, and each
# submission is appended to it. Prefer an OAuth refresh token for a real Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Alternative: a service account JSON (one line). Service accounts have no Drive storage, so
# GOOGLE_SHEETS_FOLDER_ID must then be a shared-drive folder the service account can edit.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_FOLDER_ID=
